{
  "info": {
    "_postman_id": "c7a84e31-89d4-4a25-8bb2-7f288a910bf2",
    "name": "Car Rental & Vehicle Fleet Management API",
    "description": "Comprehensive Postman Test Collection for Car Rental API with Supabase PostgreSQL & Auth, Date Collision Validation, and Fleet Management.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "vehicleId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "rentalId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Supabase Auth Endpoints",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"driver@travel.com\",\n  \"password\": \"mypassword123\",\n  \"name\": \"David\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Register a new customer with Supabase Auth."
          },
          "response": []
        },
        {
          "name": "Login Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set(\"token\", jsonData.token);",
                  "    pm.environment.set(\"token\", jsonData.token);",
                  "    console.log(\"Saved access token:\", jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"driver@travel.com\",\n  \"password\": \"mypassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Login customer and automatically persist the returned Supabase JWT token into collection variable {{token}}."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Vehicle Fleet Management",
      "item": [
        {
          "name": "Get All Vehicles",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/vehicles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vehicles"]
            },
            "description": "Fetch all vehicles in the fleet."
          },
          "response": []
        },
        {
          "name": "Filter Vehicles (by Category & Status)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/vehicles?category=SUV&status=available",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vehicles"],
              "query": [
                {
                  "key": "category",
                  "value": "SUV"
                },
                {
                  "key": "status",
                  "value": "available"
                }
              ]
            },
            "description": "Fetch vehicles filtered by category and status."
          },
          "response": []
        },
        {
          "name": "Get Vehicle Details with Past Rentals",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/vehicles/{{vehicleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vehicles", "{{vehicleId}}"]
            },
            "description": "Get single vehicle details including relational past rental records."
          },
          "response": []
        },
        {
          "name": "Add New Vehicle (Admin / Auth)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"brand\": \"Tesla\",\n  \"model\": \"Model 3\",\n  \"year\": 2024,\n  \"category\": \"Electric\",\n  \"daily_rate\": 4500,\n  \"fuel_type\": \"EV\",\n  \"seating_capacity\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/vehicles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vehicles"]
            },
            "description": "Add a new vehicle to the fleet (Protected)."
          },
          "response": []
        },
        {
          "name": "Update Vehicle Rate / Status (Auth)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"daily_rate\": 4800,\n  \"status\": \"maintenance\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/vehicles/{{vehicleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vehicles", "{{vehicleId}}"]
            },
            "description": "Update vehicle daily rate or status."
          },
          "response": []
        },
        {
          "name": "Delete Vehicle from Fleet (Auth)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/vehicles/{{vehicleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vehicles", "{{vehicleId}}"]
            },
            "description": "Delete a vehicle. Fails with 400 if vehicle has active or booked reservations."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Rental & Booking Operations",
      "item": [
        {
          "name": "Book Vehicle #1 (2026-05-01 to 2026-05-05)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.collectionVariables.set(\"rentalId\", jsonData.data.id);",
                  "    console.log(\"Saved rental ID:\", jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicle_id\": 1,\n  \"start_date\": \"2026-05-01\",\n  \"end_date\": \"2026-05-05\",\n  \"customer_name\": \"David\",\n  \"customer_email\": \"david@test.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/rentals",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rentals"]
            },
            "description": "Book a vehicle. Computes total cost dynamically and verifies date availability."
          },
          "response": []
        },
        {
          "name": "Book Vehicle Collision Test (2026-05-03 to 2026-05-07) - Expect 400",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicle_id\": 1,\n  \"start_date\": \"2026-05-03\",\n  \"end_date\": \"2026-05-07\",\n  \"customer_name\": \"David\",\n  \"customer_email\": \"david@test.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/rentals",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rentals"]
            },
            "description": "Attempting to book overlapping dates for the same vehicle. Expects 400 Bad Request with 'Vehicle already reserved during this timeframe'."
          },
          "response": []
        },
        {
          "name": "Get My Bookings (Auth)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/rentals/my-bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rentals", "my-bookings"]
            },
            "description": "List all rental records for the authenticated customer."
          },
          "response": []
        },
        {
          "name": "Cancel Upcoming Rental (Auth)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/rentals/{{rentalId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rentals", "{{rentalId}}", "cancel"]
            },
            "description": "Cancel an upcoming booking before its start date."
          },
          "response": []
        },
        {
          "name": "Complete Rental / Return Car (Auth)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/rentals/{{rentalId}}/complete",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rentals", "{{rentalId}}", "complete"]
            },
            "description": "Mark rental as completed and return vehicle to available status."
          },
          "response": []
        }
      ]
    }
  ]
}
