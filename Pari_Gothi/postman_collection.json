{
	"info": {
		"_postman_id": "c1a2b3c4-d5e6-7f8a-9b0c-1d2e3f4a5b6c",
		"name": "Car Rental & Fleet Booking API (Assignment 10)",
		"description": "Postman collection for Car Rental & Vehicle Fleet Management API with Supabase Auth & PostgreSQL.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5000",
			"type": "string"
		},
		{
			"key": "authToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "vehicleId",
			"value": "1",
			"type": "string"
		},
		{
			"key": "rentalId",
			"value": "1",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "0. Health Check",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/",
					"host": ["{{baseUrl}}"],
					"path": [""]
				}
			}
		},
		{
			"name": "1. Auth",
			"item": [
				{
					"name": "Register Customer",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.session && jsonData.session.access_token) {",
									"        pm.collectionVariables.set('authToken', jsonData.session.access_token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"David Driver\",\n    \"email\": \"driver@travel.com\",\n    \"password\": \"mypassword123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "register"]
						}
					}
				},
				{
					"name": "Login Customer",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('authToken', jsonData.access_token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"driver@travel.com\",\n    \"password\": \"mypassword123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "login"]
						}
					}
				}
			]
		},
		{
			"name": "2. Vehicles",
			"item": [
				{
					"name": "Get All Vehicles (Fleet Filters)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/vehicles?category=SUV&status=available",
							"host": ["{{baseUrl}}"],
							"path": ["api", "vehicles"],
							"query": [
								{
									"key": "category",
									"value": "SUV"
								},
								{
									"key": "status",
									"value": "available"
								}
							]
						}
					}
				},
				{
					"name": "Get Single Vehicle with Rental History",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/vehicles/{{vehicleId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "vehicles", "{{vehicleId}}"]
						}
					}
				},
				{
					"name": "Add Vehicle (Admin - Auth Required)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.vehicle && jsonData.vehicle.id) {",
									"        pm.collectionVariables.set('vehicleId', jsonData.vehicle.id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"brand\": \"Tesla\",\n    \"model\": \"Model 3\",\n    \"year\": 2024,\n    \"category\": \"Electric\",\n    \"daily_rate\": 4500,\n    \"fuel_type\": \"EV\",\n    \"seating_capacity\": 5,\n    \"status\": \"available\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/vehicles",
							"host": ["{{baseUrl}}"],
							"path": ["api", "vehicles"]
						}
					}
				},
				{
					"name": "Update Vehicle Rate / Status (Auth Required)",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"daily_rate\": 4800,\n    \"status\": \"available\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/vehicles/{{vehicleId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "vehicles", "{{vehicleId}}"]
						}
					}
				},
				{
					"name": "Delete Vehicle (Auth Required)",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/vehicles/{{vehicleId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "vehicles", "{{vehicleId}}"]
						}
					}
				}
			]
		},
		{
			"name": "3. Rentals & Bookings",
			"item": [
				{
					"name": "Book Vehicle (Step 1: Valid Booking 2026-05-01 to 2026-05-05)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.rental && jsonData.rental.id) {",
									"        pm.collectionVariables.set('rentalId', jsonData.rental.id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"vehicle_id\": 1,\n    \"start_date\": \"2026-05-01\",\n    \"end_date\": \"2026-05-05\",\n    \"customer_name\": \"David Driver\",\n    \"customer_email\": \"driver@travel.com\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/rentals",
							"host": ["{{baseUrl}}"],
							"path": ["api", "rentals"]
						}
					}
				},
				{
					"name": "Book Vehicle (Step 2: Collision Test 2026-05-03 to 2026-05-07 -> Expect 400 Bad Request)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"vehicle_id\": 1,\n    \"start_date\": \"2026-05-03\",\n    \"end_date\": \"2026-05-07\",\n    \"customer_name\": \"Another Customer\",\n    \"customer_email\": \"another@travel.com\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/rentals",
							"host": ["{{baseUrl}}"],
							"path": ["api", "rentals"]
						}
					}
				},
				{
					"name": "Get My Bookings (Auth Required)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/rentals/my-bookings",
							"host": ["{{baseUrl}}"],
							"path": ["api", "rentals", "my-bookings"]
						}
					}
				},
				{
					"name": "Cancel Booking (Auth Required)",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/rentals/{{rentalId}}/cancel",
							"host": ["{{baseUrl}}"],
							"path": ["api", "rentals", "{{rentalId}}", "cancel"]
						}
					}
				},
				{
					"name": "Complete Booking (Auth Required)",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/rentals/{{rentalId}}/complete",
							"host": ["{{baseUrl}}"],
							"path": ["api", "rentals", "{{rentalId}}", "complete"]
						}
					}
