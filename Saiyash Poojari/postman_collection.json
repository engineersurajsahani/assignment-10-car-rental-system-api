{
  "info": {
    "_postman_id": "c1f7a012-9218-4a99-b1d5-car-rental-api",
    "name": "Car Rental & Vehicle Fleet Management API - Supabase",
    "description": "Postman Collection for Assignment 10: Car Rental & Fleet Booking System with Supabase Auth, Fleet Management, Collision Prevention & Cost Calculations.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "1. Register Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"driver@travel.com\",\n  \"password\": \"mypassword123\",\n  \"name\": \"David\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "2. Login Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('authToken', jsonData.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"driver@travel.com\",\n  \"password\": \"mypassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Vehicles",
      "item": [
        {
          "name": "1. Get All Vehicles (Filters supported)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/vehicles?category=Electric&status=available",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vehicles"],
              "query": [
                {
                  "key": "category",
                  "value": "Electric"
                },
                {
                  "key": "status",
                  "value": "available"
                }
              ]
            }
          }
        },
        {
          "name": "2. Get Vehicle Details & History",
          "request": {
            "method": "GET",
