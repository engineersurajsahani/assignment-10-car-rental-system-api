    {
      "name": "2. Vehicle Fleet Management",
      "item": [
        {
          "name": "Fetch All Vehicles (Public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/vehicles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vehicles"]
            }
          }
        },
        {
          "name": "Filter Vehicles by Category and Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/vehicles?category=SUV&status=available",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vehicles"],
              "query": [
                { "key": "category", "value": "SUV" },
                { "key": "status", "value": "available" }
              ]
            }
          }
        },
        {
          "name": "Get Vehicle Details with Past Rentals (Join)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/vehicles/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vehicles", "1"]
            }
          }
        },
        {
          "name": "Add New Vehicle to Fleet (Auth)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"brand\": \"Tesla\",\n  \"model\": \"Model 3\",\n  \"year\": 2024,\n  \"category\": \"Electric\",\n  \"daily_rate\": 4500,\n  \"fuel_type\": \"EV\",\n  \"seating_capacity\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/vehicles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vehicles"]
            }
          }
        },
        {
          "name": "Update Vehicle Rate / Status (Auth)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"daily_rate\": 4800,\n  \"status\": \"maintenance\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/vehicles/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vehicles", "1"]
            }
          }
        },
        {
          "name": "Delete Vehicle (Auth)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/vehicles/3",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vehicles", "3"]
            }
          }
        }
      ]
